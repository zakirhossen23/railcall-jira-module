# Jira Cloud Configuration
# Set these environment variables for the Jira module to work.

# Your Jira instance domain (e.g., yourcompany.atlassian.net)
JIRA_DOMAIN=yourcompany.atlassian.net

# Your Jira account email (used with the API token)
JIRA_EMAIL=your.email@example.com

# Your Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_api_token_here

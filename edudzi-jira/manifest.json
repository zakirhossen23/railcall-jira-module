{
  "id": "edudzi/jira",
  "name": "edudzi-jira",
  "version": "0.1.0",
  "manifest_version": 2,
  "publisher_pubkey": "546d605f7763ccd862d5d286b375047f638f1c1053c71540aa4c8b2f6ee66cbc",
  "provider": "edudzi-jira",
  "description": "Jira Cloud adapter for RailCall. Creates, updates, searches, and transitions issues via the Jira REST API v3 using Basic Auth (email + API token). All writes are dry-run / approval-gated by RailCall. contest:2026Q3",
  "credential_spec": {
    "provider": "edudzi-jira",
    "category": "DevOps & Issue Tracking",
    "name": "edudzi-jira",
    "required": ["JIRA_DOMAIN", "JIRA_EMAIL", "JIRA_API_TOKEN"],
    "optional": [],
    "shape": "env",
    "risk": "medium",
    "read_write": "write"
  },
  "allowed_destinations": [
    {
      "provider": "edudzi-jira",
      "hosts": ["*.atlassian.net", "*.jira.com"]
    }
  ],
  "commands": [
    {
      "id": "jira.createIssue",
      "title": "Create a Jira issue",
      "provider": "edudzi-jira",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "project_key": { "type": "string", "required": true, "description": "Project key, e.g. PROJ" },
        "summary": { "type": "string", "required": true, "description": "Issue summary / title" },
        "description": { "type": "string", "required": false, "description": "Plain-text description (converted to ADF)" },
        "issue_type": { "type": "string", "required": false, "description": "Issue type name, defaults to Task" }
      },
      "output_schema": {
        "id": "string",
        "key": "string",
        "self": "string"
      }
    },
    {
      "id": "jira.updateIssue",
      "title": "Update a Jira issue's fields",
      "provider": "edudzi-jira",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true, "description": "Issue key (PROJ-123) or numeric id" },
        "summary": { "type": "string", "required": false },
        "description": { "type": "string", "required": false }
      },
      "output_schema": {
        "id_or_key": "string",
        "updated": "boolean"
      }
    },
    {
      "id": "jira.searchIssues",
      "title": "Search Jira issues (JQL)",
      "provider": "edudzi-jira",
      "risk": "low",
      "mode": "read",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "jql": { "type": "string", "required": true, "description": "JQL query, e.g. project = \"PROJ\" ORDER BY created DESC" },
        "fields": { "type": "array", "required": false, "description": "Fields to return (default: summary, status, assignee)" },
        "max_results": { "type": "integer", "required": false }
      },
      "output_schema": {
        "issues": "array",
        "count": "number",
        "next_page_token": "string",
        "is_last": "boolean"
      }
    },
    {
      "id": "jira.transitionIssue",
      "title": "Transition a Jira issue to a new status",
      "provider": "edudzi-jira",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true },
        "transition_id": { "type": "string", "required": true, "description": "Transition id, e.g. 31" }
      },
      "output_schema": {
        "id_or_key": "string",
        "transition_id": "string"
      }
    },
    {
      "id": "jira.getIssue",
      "title": "Get Jira issue details",
      "provider": "edudzi-jira",
      "risk": "low",
      "mode": "read",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true, "description": "Issue key (PROJ-123) or numeric id" },
        "fields": { "type": "array", "required": false, "description": "Fields to return (default: all)" }
      },
      "output_schema": {
        "id": "string",
        "key": "string",
        "summary": "string",
        "status": "string",
        "assignee": "string",
        "fields": "object"
      }
    },
    {
      "id": "jira.addComment",
      "title": "Add a comment to a Jira issue",
      "provider": "edudzi-jira",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true },
        "comment": { "type": "string", "required": true, "description": "Comment text (converted to ADF)" }
      },
      "output_schema": {
        "comment_id": "string",
        "created": "string",
        "self": "string"
      }
    },
    {
      "id": "jira.assignUser",
      "title": "Assign a Jira issue to a user",
      "provider": "edudzi-jira",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true },
        "account_id": { "type": "string", "required": false, "description": "Assignee Atlassian accountId" },
        "email": { "type": "string", "required": false, "description": "Assignee email (resolved to accountId)" }
      },
      "output_schema": {
        "id_or_key": "string",
        "account_id": "string"
      }
    },
    {
      "id": "jira.attachFile",
      "title": "Upload a file to a Jira issue",
      "provider": "edudzi-jira",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true },
        "file_name": { "type": "string", "required": true, "description": "Filename to attach, e.g. screenshot.png" },
        "file_content": { "type": "string", "required": true, "description": "File contents (text or base64-encoded bytes)" },
        "file_is_base64": { "type": "boolean", "required": false, "description": "Set true if file_content is base64" }
      },
      "output_schema": {
        "attachments": "array",
        "count": "number"
      }
    },
    {
      "id": "jira.deleteIssue",
      "title": "Delete a Jira issue",
      "provider": "edudzi-jira",
      "risk": "high",
      "mode": "write_requires_approval",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {
        "issue_id_or_key": { "type": "string", "required": true },
        "delete_subtasks": { "type": "boolean", "required": false, "description": "Also delete subtasks (default false)" }
      },
      "output_schema": {
        "id_or_key": "string",
        "deleted": "boolean"
      }
    },
    {
      "id": "jira.listIssueTypes",
      "title": "List Jira issue types",
      "provider": "edudzi-jira",
      "risk": "low",
      "mode": "read",
      "requires": ["jira"],
      "preview": true,
      "receipt_required": true,
      "input_schema": {},
      "output_schema": {
        "issue_types": "array",
        "count": "number"
      }
    }
  ],
  "category": "Eng",
  "python": true,
  "dependencies": {
    "requests": ">=2.25.0"
  }
}

# Jira Cloud credentials (copy to .env and fill in — .env is git-ignored)
#
# HOW TO FIND YOUR JIRA_DOMAIN:
#   Log in to Jira Cloud, then look at the browser URL bar.
#   It is the hostname before ".atlassian.net", e.g.:
#     https://yourcompany.atlassian.net/jira/...  ->  yourcompany.atlassian.net
#   (Jira Product Discovery / Jira Software / Jira Service Management all share
#   the same <site>.atlassian.net domain.)
#
# Domain WITHOUT https:// — e.g. yourcompany.atlassian.net
JIRA_DOMAIN=yourcompany.atlassian.net

# The account email tied to the API token
JIRA_EMAIL=you@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
# (If you get "401 Client must be authenticated", the token is expired/revoked
#  or the email doesn't match — generate a fresh one at the link above.)
JIRA_API_TOKEN=your-api-token
